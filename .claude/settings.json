{
  "permissions": {
    "allow": [
      "Bash(make help)",
      "Bash(make sync)",
      "Bash(make status)",
      "Bash(make task *)",
      "Bash(make lint)",
      "Bash(make test)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git fetch *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh repo list *)",
      "Bash(gh repo view *)",
      "Bash(gh search prs *)",
      "Bash(pre-commit run *)"
    ],
    "deny": [
      "Bash(gh pr merge *--admin*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push * main)",
      "Bash(git push * HEAD:main)",
      "Bash(git push * master)",
      "Bash(terraform apply *)",
      "Bash(terraform * apply *)",
      "Bash(terraform destroy *)",
      "Bash(terraform * destroy *)",
      "Bash(make apply *)",
      "Bash(make apply)",
      "Bash(make destroy *)",
      "Bash(make destroy)",
      "Bash(make -C * apply *)",
      "Bash(make -C * destroy *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo archive *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/session-sync.sh",
            "timeout": 150
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/require-verified.py"
          }
        ]
      }
    ]
  }
}
