{
  "name": "factory",
  "image": "ghcr.io/jay-withers/dev-containers/terraform:v0.16.13@sha256:f7c8bca6dab6d3db059285c62879f0357a9594b5cd42aaef319cd9c1c674854f",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "hashicorp.terraform",
        "ms-python.python",
        "redhat.vscode-yaml",
        "github.vscode-github-actions",
        "github.vscode-pull-request-github",
        "eamodio.gitlens",
        "mhutchie.git-graph",
        "editorconfig.editorconfig"
      ]
    }
  },
  "remoteUser": "vscode",
  "postCreateCommand": {
    "install": "make install",
    "login-hook": "grep -qs scripts/login.sh ~/.bashrc || echo \"$PWD/scripts/login.sh\" >> ~/.bashrc"
  },
  "postStartCommand": "gh auth status >/dev/null 2>&1 && make sync || echo 'Not logged in to GitHub: open a terminal to log in'"
}
